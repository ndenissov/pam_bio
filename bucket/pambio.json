{
    "version": "0.33.1",
    "description": "PamBio: Biometric authentication for Windows using your Android phone",
    "homepage": "https://github.com/ndenissov/pam_bio",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/ndenissov/pam_bio/releases/download/v0.33.1/pambiod.exe",
                "https://github.com/ndenissov/pam_bio/releases/download/v0.33.1/pambio_cp.dll"
            ],
            "hash": [
                "dbb0a077ac62ca81916c6145b0bb22327ccc664e764c1d45c6b1877ac2f3fc48",
                "a3b0140b33511ee16073606d147bc19d576a95db8a6476c7677f6c3c8d1fc6c3"
            ]
        }
    },
    "installer": {
        "script": [
            "Write-Host 'Registering PamBio Service...'",
            "New-Service -Name 'pambiod' -DisplayName 'PamBio Daemon' -BinaryPathName \"$dir\\pambiod.exe serve\" -StartupType Automatic | Out-Null",
            "Start-Service -Name 'pambiod'",
            "Write-Host 'Registering Credential Provider...'",
            "regsvr32.exe /s \"$dir\\pambio_cp.dll\""
        ]
    },
    "uninstaller": {
        "script": [
            "Write-Host 'Unregistering Credential Provider...'",
            "regsvr32.exe /s /u \"$dir\\pambio_cp.dll\"",
            "Write-Host 'Stopping and removing PamBio Service...'",
            "Stop-Service -Name 'pambiod' -ErrorAction SilentlyContinue",
            "sc.exe delete pambiod | Out-Null"
        ]
    },
    "bin": "pambiod.exe"
}
