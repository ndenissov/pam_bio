    <string name="notifications_denied_title">Notifications Disabled</string>
    <string name="notifications_denied_text">Without notification permission the app cannot run in the background — the background service requires a persistent notification, and authentication requests are delivered through notifications too.\n\nWe promise: not a single extra notification. Only authentication requests and service status.</string>
    <string name="open_settings">Open Settings</string>
    <string name="fullscreen_permission_title">Full-Screen Alerts</string>
    <string name="fullscreen_permission_text">To show authentication prompts on the lock screen, the app needs permission for full-screen notifications.\n\nWithout it, sudo and screen unlock requests will only appear as regular notifications.</string>
    <string name="allow">Allow</string>
    <string name="security_required_title">Screen Lock Required</string>
    <string name="security_required_desc">PamBio requires your device to have a secure screen lock (PIN, Password, or Biometrics) to safely store authentication keys.</string>
    <string name="first_launch_bio_title">Protect app with biometrics?</string>
    <string name="first_launch_bio_text">By default, opening the app does not require biometrics because it doesn\'t grant access to your PC. However, an unauthorized person could see the request history or delete paired PCs. Do you want to require biometrics every time you open the app?</string>
    <string name="first_launch_bio_yes">Yes, protect it</string>
    <string name="first_launch_bio_no">No, leave it as is</string>
